<Window x:Class="Ada.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ada — protótipo de telemetria" Height="600" Width="820" MinHeight="450" MinWidth="640">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Ada — viabilidade"/>
            <TextBlock Margin="0,4,0,12" Text="Leitura de sensores e métricas de um processo, sem injeção no jogo."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock VerticalAlignment="Center" Text="PID do jogo:"/>
                <TextBox x:Name="ProcessIdBox" Width="100" Margin="8,0" VerticalContentAlignment="Center"/>
                <Button x:Name="TrackButton" Width="120" Content="Monitorar" Click="TrackButton_Click"/>
                <Button x:Name="OverlayButton" Width="140" Margin="8,0,0,0" Content="Mostrar overlay" Click="OverlayButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="FrameStatus" Margin="0,0,0,6" Text="PresentMon: informe o PID de um jogo."/>
            <TextBlock x:Name="FrameValues" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Text="FPS — · frametime — · CPU Busy — · GPU Busy —"/>
            <TextBlock x:Name="SensorStatus" Margin="0,0,0,6" Text="Sensores: iniciando..."/>
        </StackPanel>
        <ListView x:Name="SensorList" ItemsSource="{Binding SensorReadings}" ScrollViewer.CanContentScroll="True">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Dispositivo" DisplayMemberBinding="{Binding Device}" Width="220"/>
                    <GridViewColumn Header="Sensor" DisplayMemberBinding="{Binding Name}" Width="270"/>
                    <GridViewColumn Header="Valor" DisplayMemberBinding="{Binding DisplayValue}" Width="140"/>
                    <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Type}" Width="110"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
